{
  "name": "solc-bench-cli",
  "version": "0.1.0",
  "description": "Sandboxed benchmark runner for different solidity compilers",
  "license": "MIT",
  "type": "module",
  "bin": {
    "solc-bench": "dist/cli.js"
  },
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "solidity",
    "evm",
    "compiler",
    "benchmark",
    "foundry"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepack": "npm run build"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "typescript": "7.0.2"
  },
  "dependencies": {
    "@clack/prompts": "1.8.1"
  }
}
